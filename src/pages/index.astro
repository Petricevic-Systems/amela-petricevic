---
import { link } from '../utils/url';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroImage from '../components/HeroImage.astro';
import ProjectRow from '../components/ProjectRow.astro';
import SampleTag from '../components/SampleTag.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import site from '../data/site.json';
import { formatDate, plural } from '../i18n/bs';

const allProjects = (await getCollection('projekti')).sort((a, b) => b.data.year - a.data.year);
const projects = allProjects.filter((p) => p.data.featured).slice(0, 3);
const certificates = await getCollection('certifikati');
const media = (await getCollection('mediji')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const videos = media.filter((m) => m.data.youtube && m.data.type !== 'film').slice(0, 3);
const tvCount = media.filter((m) => m.data.type === 'TV').length;
const posts = (await getCollection('pisanje', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const [firstName, ...rest] = site.name.split(' ');
const lastName = rest.join(' ');

// Brojke izračunate iz stvarnog sadržaja stranice.
const highlights = [
  { value: tvCount, label: plural(tvCount, 'TV gostovanje', 'TV gostovanja', 'TV gostovanja') },
  {
    value: certificates.length,
    label: plural(certificates.length, 'certifikat za trenericu', 'certifikata za trenericu', 'certifikata za trenericu'),
  },
  {
    value: allProjects.length,
    label: plural(allProjects.length, 'projekat i program', 'projekta i programa', 'projekata i programa'),
  },
];

const roles = [
  {
    icon: 'book',
    title: 'Učiteljica',
    text: 'Razredna nastava u Tuzli. Škola kao zajednica u kojoj se vrijednosti žive svaki dan.',
    href: link('/o-meni'),
  },
  {
    icon: 'people',
    title: 'Trenerica nastavnika',
    text: 'Certificirana trenerica TPO Fondacije za programe Etos inicijativa i EMIL.',
    href: link('/edukacije'),
  },
  {
    icon: 'bulb',
    title: 'Autorica projekata',
    text: 'Školski projekti, filmovi i inicijative koje povezuju učenike, roditelje i zajednicu.',
    href: link('/projekti'),
  },
];
---

<BaseLayout
  title="Početna"
  description={`${site.name} — učiteljica iz Tuzle i trenerica nastavnika (Etos inicijativa, EMIL). Edukacije, radionice, projekti i nastupi u medijima.`}
>
  <section class="hero">
    <div class="wrap">
      <h1 class="wordmark">
        <span>{firstName}</span>
        <span class="indent">{lastName}</span>
      </h1>
      <p class="roles-line">Učiteljica • Trenerica nastavnika • Autorica projekata</p>
      <div class="btn-row hero-cta">
        <a class="btn" href={link('/kontakt?tema=edukacija')}>Pozovi me na edukaciju</a>
        <a class="btn btn--line" href={link('/projekti')}>Pogledaj projekte</a>
      </div>
    </div>
  </section>

  {
    site.photos.hero ? (
      <HeroImage src={link(site.photos.hero)} alt={`${site.name} na edukaciji za nastavnike`} />
    ) : (
      <section class="band" aria-label="Ukratko">
        <div class="wrap">
          <ul>
            {highlights.map((h) => (
              <li>
                <span class="hl-num">{h.value}</span>
                <span class="hl-label">{h.label}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="about-section">
    <div class="wrap about">
      <div class="about-media">
        {
          site.photos.portrait ? (
            <img src={link(site.photos.portrait)} alt={site.name} width="600" height="800" loading="lazy" />
          ) : (
            <div class="about-placeholder" aria-hidden="true">
              <span>AP</span>
            </div>
          )
        }
      </div>
      <div class="about-card">
        <span class="label">O meni</span>
        <h2>O Ameli</h2>
        <p>{site.shortBio}</p>
        <a class="btn" href={link('/o-meni')}>Pročitaj cijelu biografiju</a>
      </div>
    </div>
    <div class="wrap">
      <ul class="tiles">
        {
          roles.map((r) => (
            <li>
              <a class="tile" href={r.href}>
                <span class="tile-icon" aria-hidden="true">
                  {r.icon === 'book' && (
                    <svg viewBox="0 0 48 48" width="40" height="40" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round">
                      <path d="M6 10c6-2 12-2 18 2v28c-6-4-12-4-18-2z" />
                      <path d="M42 10c-6-2-12-2-18 2v28c6-4 12-4 18-2z" />
                    </svg>
                  )}
                  {r.icon === 'people' && (
                    <svg viewBox="0 0 48 48" width="40" height="40" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                      <circle cx="17" cy="16" r="6" />
                      <circle cx="33" cy="18" r="5" />
                      <path d="M5 40c1-8 6-12 12-12s11 4 12 12" />
                      <path d="M29 30c2-2 3-3 5-3 5 0 8 4 9 11" />
                    </svg>
                  )}
                  {r.icon === 'bulb' && (
                    <svg viewBox="0 0 48 48" width="40" height="40" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M17 32c0-4-6-7-6-14a13 13 0 0 1 26 0c0 7-6 10-6 14z" />
                      <path d="M18 38h12M20 43h8" />
                    </svg>
                  )}
                </span>
                <span class="tile-title">{r.title}</span>
                <span class="tile-text">{r.text}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="label">U medijima</span>
          <h2>Razgovori i gostovanja</h2>
        </div>
        <a class="more" href={link('/mediji')}>Svi nastupi</a>
      </div>
      <ul class="cards grid grid--3">
        {
          videos.map((v) => (
            <li class="card">
              <div class="card-media">
                <VideoEmbed id={v.data.youtube!} title={v.data.title} outlet={v.data.outlet} thumbnail={v.data.thumbnail} embeddable={v.data.embeddable} />
                <span class="card-tag">{v.data.outlet}</span>
              </div>
              <div class="card-body">
                <p class="tagline">{formatDate(v.data.date)}</p>
                <h3>{v.data.title}</h3>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="label">Projekti i inicijative</span>
          <h2>Odabrani projekti</h2>
        </div>
        <a class="more" href={link('/projekti')}>Svi projekti</a>
      </div>
      <ol class="rows">
        {projects.map((p) => <ProjectRow project={p} full={false} />)}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="label">Pisanje</span>
          <h2>Tekstovi i materijali</h2>
        </div>
        <a class="more" href={link('/pisanje')}>Sve objave</a>
      </div>
      <ul class="cards grid grid--3">
        {
          posts.map((post) => (
            <li class="card">
              <div class="card-media card-media--text" aria-hidden="true">
                {post.data.title.charAt(0)}
                <span class="card-tag">{post.data.tags[0] ?? 'Blog'}</span>
              </div>
              <div class="card-body">
                <p class="tagline">
                  <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                  <SampleTag show={post.data.sample} />
                </p>
                <h3>
                  <a href={link(`/pisanje/${post.id}`)}>{post.data.title}</a>
                </h3>
                <p class="muted clamp">{post.data.summary}</p>
                <span class="more" aria-hidden="true">
                  Pročitaj više
                </span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--dark cta">
    <div class="wrap">
      <div class="section-head section-head--center">
        <div>
          <span class="label">Saradnja</span>
          <h2>Planirate edukaciju, projekat ili razgovor?</h2>
          <p>Edukacije za nastavnike, radionice, partnerstva na projektima i izjave za medije.</p>
        </div>
      </div>
      <p class="center"><a class="btn" href={link('/kontakt')}>Kontaktirajte me</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  /* Naslovni dio: samo ime kao znak, kao kod uzora */
  .hero {
    padding-block: clamp(3.5rem, 11vw, 8rem);
  }
  .wordmark {
    display: inline-flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3.6rem, 13vw, 8.75rem);
    line-height: 0.86;
    letter-spacing: -0.005em;
    color: var(--ink);
    margin: 0;
  }
  .indent {
    padding-left: 0.42em;
  }
  .roles-line {
    margin: 1.25rem 0 0;
    font-weight: 700;
    font-size: clamp(0.78rem, 1.7vw, 1.05rem);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .hero-cta {
    margin-top: 2.25rem;
  }

  /* Široka traka (mjesto naslovne fotografije) */
  .band {
    background:
      repeating-linear-gradient(135deg, rgb(255 255 255 / 0.04) 0 2px, transparent 2px 16px),
      radial-gradient(60rem 30rem at 85% 0%, var(--dark-2), transparent 70%),
      var(--dark);
    color: #fff;
    padding-block: clamp(3rem, 8vw, 5.5rem);
  }
  .band ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 44rem) {
    .band ul {
      grid-template-columns: repeat(3, 1fr);
    }
    .band li + li {
      border-left: 1px solid rgb(255 255 255 / 0.15);
      padding-left: 2rem;
    }
  }
  .band li {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .hl-num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3.2rem, 7vw, 4.75rem);
    line-height: 1;
    color: var(--accent-soft);
  }
  .hl-label {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #d7e4e3;
  }

  /* O meni: slika lijevo, bijela kartica preklapa desno; pločice preklapaju donji rub */
  .about-section {
    background: linear-gradient(var(--paper-2) 0 calc(100% - 5rem), var(--white) calc(100% - 5rem));
    padding-top: clamp(3.5rem, 8vw, 6rem);
  }
  .about {
    display: grid;
    align-items: center;
    max-width: 64rem;
  }
  @media (min-width: 52rem) {
    .about {
      grid-template-columns: 22rem 1fr;
    }
    .about-card {
      margin-left: -3rem;
    }
  }
  .about-media img,
  .about-placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .about-placeholder {
    display: grid;
    place-items: center;
    background:
      repeating-linear-gradient(135deg, rgb(255 255 255 / 0.05) 0 2px, transparent 2px 16px),
      linear-gradient(160deg, var(--dark-2), var(--dark));
    font-family: var(--font-display);
    font-size: 6rem;
    color: rgb(255 255 255 / 0.85);
  }
  @media (max-width: 51.99rem) {
    .about-media {
      max-width: 22rem;
    }
    .about-placeholder {
      aspect-ratio: 16 / 9;
      font-size: 4rem;
    }
    .about-media {
      max-width: none;
    }
  }
  .about-card {
    position: relative;
    background: var(--white);
    padding: clamp(1.75rem, 4vw, 3rem);
    box-shadow: var(--shadow);
  }
  .about-card p {
    color: var(--ink-2);
    margin-bottom: 1.75rem;
  }

  .tiles {
    list-style: none;
    margin: clamp(3rem, 6vw, 4.5rem) 0 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }
  @media (min-width: 52rem) {
    .tiles {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .tile {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 2.25rem 2rem 2.5rem;
    background: var(--dark);
    color: #d7e4e3;
    transition: background 0.2s;
  }
  .tile:hover {
    background: var(--dark-2);
    color: #fff;
    text-decoration: none;
  }
  .tile-icon {
    color: var(--accent-soft);
    margin-bottom: 1.5rem;
  }
  .tile-title {
    font-size: 1.5rem;
    font-weight: 900;
    color: #fff;
  }
  .tile-title::after {
    content: '';
    display: block;
    width: 2.75rem;
    height: 3px;
    margin: 0.9rem 0 1.1rem;
    background: var(--accent-soft);
  }
  .tile-text {
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .card-media :global(.video) {
    position: absolute;
    inset: 0;
    aspect-ratio: auto;
  }
  .card .card-media :global(.plain-title) {
    font-size: 1.15rem;
  }

  .center {
    text-align: center;
    margin: 0;
  }
  .cta .section-head {
    margin-bottom: 2rem;
  }
</style>
