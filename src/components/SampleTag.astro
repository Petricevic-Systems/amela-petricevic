---
interface Props {
  show?: boolean;
}
const { show = true } = Astro.props;
---

{show && <span class="sample-tag" title="Primjer sadržaja — zamijeniti stvarnim podacima">Primjer</span>}

<style>
  .sample-tag {
    display: inline-block;
    padding: 0 0.4rem;
    border: 1px dashed var(--accent);
    font-family: var(--font-head);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.7;
    text-transform: uppercase;
    color: var(--accent);
    vertical-align: middle;
  }
</style>
