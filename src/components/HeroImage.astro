---
// Široka fotografija preko cijele širine ispod imena na početnoj (kao kod uzora).
// Pravilo: samo ona, materijali ili prostor — nikad prepoznatljiva djeca.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
}
const { src, alt } = Astro.props;
---

<figure class="hero-image">
  <Image src={src} alt={alt} widths={[800, 1400, 2200]} sizes="100vw" loading="eager" fetchpriority="high" />
</figure>

<style>
  .hero-image {
    margin: 0;
  }
  .hero-image :global(img) {
    display: block;
    width: 100%;
    height: clamp(18rem, 48vw, 36rem);
    object-fit: cover;
    object-position: 50% 30%;
  }
</style>
