---
interface Props {
  label?: string;
  title: string;
  lead?: string;
}
const { label, title, lead } = Astro.props;
---

<header class="page-header">
  <div class="wrap inner">
    {label && <span class="label">{label}</span>}
    <h1 set:html={title} />
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</header>

<style>
  .page-header {
    background: var(--paper-2);
    padding-block: clamp(3.5rem, 9vw, 6rem);
    text-align: center;
  }
  .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  h1 {
    max-width: 22ch;
    margin-bottom: 0;
  }
  h1::after {
    content: '';
    display: block;
    width: 3rem;
    height: 3px;
    margin: 1.25rem auto 0;
    background: var(--gold);
  }
  .lead {
    margin: 1.25rem auto 1.75rem;
  }
</style>
