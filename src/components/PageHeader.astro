---
// Zaglavlje unutrašnje stranice: široka traka s naslovom na sredini (kao „EDUCATOR”).
// Ako se proslijedi fotografija (image), prikazuje se iza naslova uz zatamnjenje.
import { link } from '../utils/url';

interface Props {
  label?: string;
  title: string;
  lead?: string;
  image?: string;
}
const { label, title, lead, image } = Astro.props;
const bg = image ? `background-image: linear-gradient(rgb(15 58 63 / 0.6), rgb(15 58 63 / 0.75)), url(${link(image)})` : undefined;
---

<header class="page-header" style={bg}>
  <div class="wrap inner">
    {label && <span class="label">{label}</span>}
    <h1 set:html={title} />
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</header>

<style>
  .page-header {
    background:
      repeating-linear-gradient(135deg, rgb(255 255 255 / 0.04) 0 2px, transparent 2px 16px),
      radial-gradient(60rem 30rem at 85% 0%, var(--dark-2), transparent 70%),
      var(--dark);
    background-size: cover;
    background-position: center;
    color: #fff;
    padding-block: clamp(4rem, 11vw, 7.5rem);
    text-align: center;
  }
  .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .label {
    color: var(--accent-soft);
  }
  h1 {
    max-width: 22ch;
    margin-bottom: 0;
    font-size: clamp(2.4rem, 6vw, 4rem);
    color: #fff;
  }
  h1 :global(em) {
    color: var(--accent-soft);
  }
  .lead {
    margin: 1.25rem auto 1.75rem;
    color: #c9dbd9;
  }
  .page-header :global(.btn--line) {
    border-color: #fff;
    color: #fff;
  }
  .page-header :global(.btn--line:hover) {
    background: #fff;
    color: var(--dark);
  }
</style>
