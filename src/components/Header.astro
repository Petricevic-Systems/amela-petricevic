---
import { link } from '../utils/url';
import site from '../data/site.json';
import { nav } from '../i18n/bs';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => current.startsWith(href);
const initials = site.name
  .split(/\s+/)
  .map((w) => w[0])
  .join('')
  .slice(0, 2);
// Kontakt je zasebno dugme desno, pa ga nema u glavnom meniju.
const menu = nav.filter((item) => !item.href.endsWith('/kontakt'));
---

<header class="site-header">
  <div class="bar">
    <a class="brand" href={link('/')} aria-label={`${site.name} — početna`}>
      <span class="badge" aria-hidden="true">{initials}</span>
      <span class="brand-name">{site.name}</span>
    </a>
    <nav id="glavni-meni" aria-label="Glavni meni">
      <ul>
        {
          menu.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="nav-contact-mobile"><a href={link('/kontakt')}>Kontakt</a></li>
      </ul>
    </nav>
    <a class="contact" href={link('/kontakt')}>Kontakt</a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="glavni-meni">
      <span class="bars" aria-hidden="true"></span>
      <span class="visually-hidden">Meni</span>
    </button>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('glavni-meni');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('open', !open);
  });
</script>

<style>
  .site-header {
    background: var(--white);
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    min-height: 4.5rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.75rem var(--gutter);
    color: var(--ink);
    text-decoration: none;
    margin-right: auto;
  }
  .brand:hover {
    color: var(--ink);
    text-decoration: none;
  }
  .badge {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--dark);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.02em;
    box-shadow: inset 0 0 0 2px var(--accent-soft);
  }
  .brand-name {
    font-weight: 900;
    font-size: 1rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .contact {
    display: none;
  }
  .menu-toggle {
    display: grid;
    place-items: center;
    width: 4.5rem;
    border: 0;
    border-left: 1px solid var(--line);
    background: none;
    color: var(--ink);
    cursor: pointer;
  }
  .bars,
  .bars::before,
  .bars::after {
    display: block;
    width: 20px;
    height: 2px;
    background: currentColor;
    position: relative;
  }
  .bars::before,
  .bars::after {
    content: '';
    position: absolute;
  }
  .bars::before {
    top: -6px;
  }
  .bars::after {
    top: 6px;
  }
  nav {
    display: none;
    order: 3;
    width: 100%;
    border-top: 1px solid var(--line);
  }
  nav.open {
    display: block;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0.5rem var(--gutter) 1rem;
  }
  li a {
    display: block;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  li a:hover,
  li a[aria-current='page'] {
    color: var(--accent);
    text-decoration: none;
  }
  @media (min-width: 68rem) {
    .menu-toggle,
    .nav-contact-mobile {
      display: none;
    }
    .brand {
      margin-right: 0;
      border-right: 1px solid var(--line);
    }
    nav {
      display: flex;
      order: 0;
      width: auto;
      flex: 1;
      border: 0;
    }
    ul {
      display: flex;
      align-items: stretch;
      gap: 0;
      padding: 0 1rem;
    }
    li a {
      display: flex;
      align-items: center;
      height: 100%;
      padding: 0 0.9rem;
      border: 0;
      font-size: 0.78rem;
      position: relative;
    }
    li a[aria-current='page']::after {
      content: '';
      position: absolute;
      left: 0.9rem;
      right: 0.9rem;
      bottom: 0;
      height: 3px;
      background: var(--accent);
    }
    .contact {
      display: flex;
      align-items: center;
      padding: 0 2rem;
      border-left: 1px solid var(--line);
      background: var(--accent);
      color: #fff;
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .contact:hover {
      background: var(--accent-hover);
      color: #fff;
      text-decoration: none;
    }
  }
</style>
