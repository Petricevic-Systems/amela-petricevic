---
import { link } from '../utils/url';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroImage from '../components/HeroImage.astro';
import SampleTag from '../components/SampleTag.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import site from '../data/site.json';
import { images } from '../data/images';
import { formatDate, plural, roleLabels } from '../i18n/bs';

const allProjects = (await getCollection('projekti')).sort((a, b) => b.data.year - a.data.year);
const projects = allProjects.filter((p) => p.data.featured).slice(0, 3);
const certificates = await getCollection('certifikati');
const awards = certificates.filter((c) => c.data.kind === 'nagrada').length;
const media = (await getCollection('mediji')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const videos = media.filter((m) => m.data.youtube && m.data.type !== 'film').slice(0, 3);
const tvCount = media.filter((m) => m.data.type === 'TV').length;
const posts = (await getCollection('pisanje', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const [firstName, ...rest] = site.name.split(' ');
const lastName = rest.join(' ');

// Brojke izračunate iz stvarnog sadržaja stranice.
const highlights = [
  { value: allProjects.length, label: plural(allProjects.length, 'projekat', 'projekta', 'projekata') },
  { value: tvCount, label: plural(tvCount, 'TV gostovanje', 'TV gostovanja', 'TV gostovanja') },
  { value: certificates.length - awards, label: plural(certificates.length - awards, 'certifikat', 'certifikata', 'certifikata') },
  { value: awards, label: plural(awards, 'nagrada', 'nagrade', 'nagrada') },
];

const roles = [
  {
    icon: 'book',
    title: 'Učiteljica',
    text: 'Razredna nastava u Tuzli. Vrijednosti koje djeca crtaju, snimaju i dijele sa zajednicom.',
    href: link('/o-meni'),
  },
  {
    icon: 'people',
    title: 'Trenerica nastavnika',
    text: 'Certificirana trenerica TPO Fondacije za programe Etos inicijativa i EMIL.',
    href: link('/edukacije'),
  },
  {
    icon: 'bulb',
    title: 'Autorica projekata',
    text: 'Od nagrađenog plakata do humanitarne akcije za Narodnu kuhinju „Imaret”.',
    href: link('/projekti'),
  },
];
---

<BaseLayout
  title="Početna"
  description={`${site.name} — učiteljica iz Tuzle i trenerica nastavnika (Etos inicijativa, EMIL). Projekti, edukacije, radionice i nastupi u medijima.`}
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <h1 class="wordmark">
          <span>{firstName}</span>
          <span class="indent">{lastName}</span>
        </h1>
        <p class="roles-line">Učiteljica <i>•</i> Trenerica nastavnika <i>•</i> Autorica projekata</p>
      </div>
      <div class="hero-side">
        <p>{site.shortBio}</p>
        <div class="btn-row">
          <a class="btn" href={link('/kontakt?tema=edukacija')}>Pozovi me na edukaciju</a>
          <a class="btn btn--line" href={link('/projekti')}>Projekti</a>
        </div>
      </div>
    </div>
  </section>

  <HeroImage src={images.hero.src} alt={images.hero.alt} />

  <section class="stats" aria-label="Ukratko">
    <div class="wrap">
      <ul>
        {
          highlights.map((h) => (
            <li>
              <span class="num">{h.value}</span>
              <span class="lbl">{h.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="about-section">
    <div class="wrap about">
      <div class="about-media">
        <Image src={images.about.src} alt={images.about.alt} widths={[500, 900]} sizes="(min-width: 52rem) 24rem, 100vw" />
      </div>
      <div class="about-card">
        <div class="who">
          <Image class="avatar" src={images.portrait.src} alt={images.portrait.alt} width={160} height={200} />
          <div>
            <span class="label">O meni</span>
            <h2>O Ameli</h2>
          </div>
        </div>
        <p>{site.longBio}</p>
        <a class="btn" href={link('/o-meni')}>Pročitaj cijelu biografiju</a>
      </div>
    </div>
    <div class="wrap">
      <ul class="tiles">
        {
          roles.map((r) => (
            <li>
              <a class="tile" href={r.href}>
                <span class="tile-icon" aria-hidden="true">
                  {r.icon === 'book' && (
                    <svg viewBox="0 0 48 48" width="38" height="38" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">
                      <path d="M6 10c6-2 12-2 18 2v28c-6-4-12-4-18-2z" />
                      <path d="M42 10c-6-2-12-2-18 2v28c6-4 12-4 18-2z" />
                    </svg>
                  )}
                  {r.icon === 'people' && (
                    <svg viewBox="0 0 48 48" width="38" height="38" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                      <circle cx="17" cy="16" r="6" />
                      <circle cx="33" cy="18" r="5" />
                      <path d="M5 40c1-8 6-12 12-12s11 4 12 12" />
                      <path d="M29 30c2-2 3-3 5-3 5 0 8 4 9 11" />
                    </svg>
                  )}
                  {r.icon === 'bulb' && (
                    <svg viewBox="0 0 48 48" width="38" height="38" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M17 32c0-4-6-7-6-14a13 13 0 0 1 26 0c0 7-6 10-6 14z" />
                      <path d="M18 38h12M20 43h8" />
                    </svg>
                  )}
                </span>
                <span class="tile-title">{r.title}</span>
                <span class="tile-text">{r.text}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="label">Projekti i inicijative</span>
          <h2>Odabrani projekti</h2>
        </div>
        <a class="more" href={link('/projekti')}>Svi projekti</a>
      </div>
      <ul class="cards grid grid--3">
        {
          projects.map(({ id, data }) => (
            <li class="card">
              <div class="card-media">
                {data.image && (
                  <Image src={data.image} alt={data.imageAlt} widths={[400, 700]} sizes="(min-width: 64rem) 22rem, (min-width: 44rem) 45vw, 100vw" />
                )}
                <span class="card-tag">{roleLabels[data.role]}</span>
              </div>
              <div class="card-body">
                <p class="tagline">{data.yearEnd ? `${data.year}–${data.yearEnd}` : data.year}</p>
                <h3>
                  <a href={link(`/projekti#${id}`)}>{data.title}</a>
                </h3>
                <p class="muted clamp">{data.outcome}</p>
                <span class="more" aria-hidden="true">
                  Pročitaj više
                </span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="feature">
    <div class="feature-media">
      <Image src={images.poster.src} alt={images.poster.alt} widths={[500, 850]} sizes="(min-width: 56rem) 50vw, 100vw" />
    </div>
    <div class="feature-text">
      <span class="label">Prva nagrada · Etos inicijativa 2018.</span>
      <h2>„Svjetski etos je u nama”</h2>
      <p>
        Moji učenici nacrtali su vrijednosti koje žive u svojoj školi — poštovanje, prijateljstvo, brigu o
        drugima i o prirodi. Njihov plakat osvojio je prvu nagradu za osnovne škole na završnoj konferenciji Etos
        inicijative u Sarajevu.
      </p>
      <a class="more" href={link('/projekti')}>O projektu</a>
    </div>
  </section>

  <section class="section section--dark">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="label">U medijima</span>
          <h2>Razgovori i gostovanja</h2>
        </div>
        <a class="more" href={link('/mediji')}>Svi nastupi</a>
      </div>
      <ul class="grid grid--3 videos">
        {
          videos.map((v) => (
            <li>
              <VideoEmbed id={v.data.youtube!} title={v.data.title} outlet={v.data.outlet} thumbnail={v.data.thumbnail} embeddable={v.data.embeddable} />
              <p class="v-meta">
                {v.data.outlet} · {formatDate(v.data.date)}
              </p>
              <h3>{v.data.title}</h3>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="label">Pisanje</span>
          <h2>Tekstovi i materijali</h2>
        </div>
        <a class="more" href={link('/pisanje')}>Sve objave</a>
      </div>
      <ul class="cards grid grid--3">
        {
          posts.map((post) => (
            <li class="card">
              <div class="card-media">
                {post.data.image && <Image src={post.data.image} alt="" widths={[400, 700]} sizes="(min-width: 64rem) 22rem, (min-width: 44rem) 45vw, 100vw" />}
                <span class="card-tag">{post.data.tags[0] ?? 'Blog'}</span>
              </div>
              <div class="card-body">
                <p class="tagline">
                  <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                  <SampleTag show={post.data.sample} />
                </p>
                <h3>
                  <a href={link(`/pisanje/${post.id}`)}>{post.data.title}</a>
                </h3>
                <p class="muted clamp">{post.data.summary}</p>
                <span class="more" aria-hidden="true">
                  Pročitaj više
                </span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="cta">
    <div class="wrap">
      <h2>Planirate edukaciju, projekat ili razgovor?</h2>
      <p>Edukacije za nastavnike, radionice, partnerstva na projektima i izjave za medije.</p>
      <a class="btn btn--dark" href={link('/kontakt')}>Kontaktirajte me</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(3.5rem, 10vw, 7.5rem) clamp(3rem, 7vw, 5rem);
  }
  .hero-grid {
    display: grid;
    gap: 2.5rem;
    align-items: end;
  }
  @media (min-width: 64rem) {
    .hero-grid {
      grid-template-columns: auto minmax(18rem, 24rem);
      justify-content: space-between;
    }
  }
  .wordmark {
    display: inline-flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3.6rem, 12.5vw, 8.5rem);
    line-height: 0.86;
    letter-spacing: 0;
    margin: 0;
  }
  .indent {
    padding-left: 0.42em;
  }
  .roles-line {
    margin: 1.25rem 0 0;
    font-weight: 700;
    font-size: clamp(0.75rem, 1.6vw, 1rem);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .roles-line i {
    font-style: normal;
    color: var(--gold);
    padding-inline: 0.2em;
  }
  .hero-side p {
    color: var(--ink-2);
    margin-bottom: 1.5rem;
  }

  .stats {
    background: var(--dark);
    color: #fff;
    padding-block: 1.75rem;
  }
  .stats ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }
  @media (min-width: 48rem) {
    .stats ul {
      grid-template-columns: repeat(4, 1fr);
    }
    .stats li + li {
      border-left: 1px solid #3a3835;
      padding-left: 1.75rem;
    }
  }
  .stats li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  .num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.2rem, 4vw, 2.8rem);
    line-height: 1;
    color: var(--gold);
  }
  .lbl {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #cfccc4;
  }

  .about-section {
    background: linear-gradient(var(--paper-2) 0 calc(100% - 5rem), var(--white) calc(100% - 5rem));
    padding-top: clamp(4rem, 9vw, 7rem);
  }
  .about {
    display: grid;
    align-items: center;
    max-width: 66rem;
  }
  @media (min-width: 52rem) {
    .about {
      grid-template-columns: 24rem 1fr;
    }
    .about-card {
      margin-left: -4rem;
    }
  }
  .about-media :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
  }
  @media (max-width: 51.99rem) {
    .about-media :global(img) {
      aspect-ratio: 16 / 9;
    }
  }
  .about-card {
    position: relative;
    background: var(--white);
    padding: clamp(1.75rem, 4vw, 3.25rem);
    box-shadow: var(--shadow);
  }
  .who {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1.25rem;
  }
  .who h2 {
    margin: 0;
  }
  .who :global(.avatar) {
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 30%;
    box-shadow: 0 0 0 3px var(--white), 0 0 0 4px var(--gold);
  }
  .about-card p {
    color: var(--ink-2);
    margin-bottom: 1.75rem;
  }

  .tiles {
    list-style: none;
    margin: clamp(3.5rem, 7vw, 5rem) 0 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  @media (min-width: 52rem) {
    .tiles {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .tile {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 2.25rem 2rem 2.5rem;
    background: var(--dark);
    color: #b9b5ad;
    transition: background 0.2s;
  }
  .tile:hover {
    background: var(--dark-2);
    color: #e9e6df;
    text-decoration: none;
  }
  .tile-icon {
    color: var(--gold);
    margin-bottom: 1.5rem;
  }
  .tile-title {
    font-size: 1.4rem;
    font-weight: 900;
    color: #fff;
  }
  .tile-title::after {
    content: '';
    display: block;
    width: 2.5rem;
    height: 2px;
    margin: 0.9rem 0 1.1rem;
    background: var(--gold);
  }
  .tile-text {
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .feature {
    display: grid;
    background: var(--paper-2);
  }
  @media (min-width: 56rem) {
    .feature {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }
  }
  .feature-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 38rem;
    object-fit: cover;
  }
  .feature-text {
    padding: clamp(2.5rem, 6vw, 5rem) var(--gutter);
    max-width: 36rem;
  }
  .feature-text p {
    color: var(--ink-2);
    margin-bottom: 1.5rem;
  }

  .videos {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .v-meta {
    margin: 1rem 0 0.25rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .videos h3 {
    color: #fff;
    font-size: 1.1rem;
  }

  .cta {
    background: var(--gold);
    padding-block: clamp(3.5rem, 8vw, 5rem);
    text-align: center;
  }
  .cta h2 {
    margin-bottom: 0.75rem;
  }
  .cta p {
    max-width: 36rem;
    margin: 0 auto 1.75rem;
  }
  .btn--dark {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }
  .btn--dark:hover {
    background: #000;
    border-color: #000;
    color: #fff;
  }
</style>
