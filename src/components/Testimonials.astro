---
// Preporuke kao bijele kartice na tamnoj traci (kao „STUDENT FEEDBACK”).
// Prikazuju se samo preporuke za koje je osoba dala dozvolu (permission: true).
import { getCollection } from 'astro:content';
import SampleTag from './SampleTag.astro';

interface Props {
  title?: string;
  label?: string;
}
const { title = 'Šta kažu kolege i partneri', label = 'Utisci' } = Astro.props;
const items = (await getCollection('preporuke')).filter((t) => t.data.permission);
---

{
  items.length > 0 && (
    <section class="section section--dark feedback">
      <div class="wrap">
        <div class="section-head section-head--center">
          <div>
            <span class="label">{label}</span>
            <h2>{title}</h2>
          </div>
        </div>
        <ul class="grid grid--3 quotes">
          {items.map(({ data }) => (
            <li>
              <figure class="quote">
                <span class="mark" aria-hidden="true">
                  „
                </span>
                <figcaption>
                  <strong>{data.author}</strong>
                  <span class="muted small">{data.role}</span>
                  <SampleTag show={data.sample} />
                </figcaption>
                <blockquote>
                  <p>{data.quote}</p>
                </blockquote>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .quotes {
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: start;
  }
  .quote {
    position: relative;
    margin: 0;
    background: var(--white);
    color: var(--ink);
    padding: 2rem 1.75rem 1.75rem;
    text-align: center;
    box-shadow: var(--shadow);
  }
  .mark {
    position: absolute;
    top: 0.25rem;
    right: 1.25rem;
    font-family: Georgia, serif;
    font-size: 4.5rem;
    line-height: 1;
    color: var(--accent-soft);
  }
  figcaption {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    margin-bottom: 1rem;
  }
  blockquote {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.98rem;
  }
  blockquote p {
    margin: 0;
  }
</style>
