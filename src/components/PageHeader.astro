---
// Zaglavlje unutrašnje stranice: fotografija preko cijele širine, zatamnjena, s naslovom na sredini.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  label?: string;
  title: string;
  lead?: string;
  image?: ImageMetadata;
}
const { label, title, lead, image } = Astro.props;
---

<header class:list={['page-header', { 'has-image': image }]}>
  {
    image && (
      <Image
        class="bg"
        src={image}
        alt=""
        widths={[800, 1400, 2200]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    )
  }
  <div class="wrap inner">
    {label && <span class="label">{label}</span>}
    <h1 set:html={title} />
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</header>

<style>
  .page-header {
    position: relative;
    overflow: hidden;
    background: var(--dark);
    color: #fff;
    padding-block: clamp(5rem, 13vw, 9rem);
    text-align: center;
  }
  .bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.35);
  }
  .has-image::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(rgb(20 20 20 / 0.55), rgb(20 20 20 / 0.72));
  }
  .inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .label {
    color: var(--gold);
  }
  h1 {
    max-width: 22ch;
    margin-bottom: 0;
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    letter-spacing: 0.02em;
    color: #fff;
  }
  h1::after {
    content: '';
    display: block;
    width: 3rem;
    height: 2px;
    margin: 1.4rem auto 0;
    background: var(--gold);
  }
  h1 :global(em) {
    color: var(--gold);
  }
  .lead {
    margin: 1.4rem auto 1.9rem;
    color: #e4e0d8;
  }
  .page-header :global(.btn--line) {
    border-color: #fff;
    color: #fff;
  }
  .page-header :global(.btn--line:hover) {
    background: #fff;
    color: var(--ink);
  }
</style>
