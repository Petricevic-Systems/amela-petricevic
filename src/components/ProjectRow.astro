---
// Projekat kao stavka s linijom ispred naslova; ispod: godina, uloga, partneri, opis, rezultat.
import { render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { roleLabels } from '../i18n/bs';
import SampleTag from './SampleTag.astro';
import SourceLink from './SourceLink.astro';

interface Props {
  project: CollectionEntry<'projekti'>;
  /** false = samo naslov, godina, uloga i rezultat (za početnu). */
  full?: boolean;
}
const { project, full = true } = Astro.props;
const { title, year, yearEnd, role, partners, outcome, source, sample, image, imageAlt } = project.data;
const years = yearEnd ? `${year}–${yearEnd}` : String(year);
const { Content } = await render(project);
---

<li class:list={['line-item', 'project', { 'with-image': full && image }]} id={project.id}>
  {
    full && image && (
      <Image class="thumb" src={image} alt={imageAlt} widths={[400, 700]} sizes="(min-width: 56rem) 20rem, 100vw" />
    )
  }
  <div class="text">
  <h3>{title}</h3>
  <p class="caption">
    <strong class="years">{years}</strong> · <span class="role">{role === 'pokretačica' ? '★ ' : ''}{roleLabels[role]}</span>
    {partners.length > 0 && <> · {partners.join(', ')}</>}
    <SampleTag show={sample} />
  </p>
  <div class="body">
    {full && <div class="desc"><Content /></div>}
    <p class="result"><strong>Rezultat:</strong> {outcome}</p>
    {full && <SourceLink href={source} />}
  </div>
  </div>
</li>

<style>
  .project {
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--line);
  }
  .project:first-child {
    padding-top: 0;
  }
  .with-image {
    display: grid;
    gap: 1.5rem 2.5rem;
  }
  @media (min-width: 56rem) {
    .with-image {
      grid-template-columns: 20rem 1fr;
      align-items: start;
    }
  }
  .project :global(.thumb) {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  .years {
    color: var(--ink);
  }
  .role {
    color: var(--accent);
    font-weight: 700;
  }
  .desc {
    color: var(--ink-2);
    max-width: 46rem;
  }
  .desc :global(p) {
    margin-bottom: 0.6rem;
  }
  .result {
    max-width: 46rem;
    margin-bottom: 0.25rem;
  }
</style>
